<Window x:Class="BisectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BisectionApp.ViewModels"
        Title="Метод половинного деления" Height="600" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="CalculateButton" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF45A049"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ввод данных -->
        <GroupBox Grid.Row="0" Header="Ввод данных" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Левая граница (a):" Width="130"/>
                    <TextBox Style="{StaticResource InputTextBox}" 
                             Text="{Binding LeftBound, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Правая граница (b):" Width="130"/>
                    <TextBox Style="{StaticResource InputTextBox}" 
                             Text="{Binding RightBound, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Точность (ε):" Width="130"/>
                    <TextBox Style="{StaticResource InputTextBox}" 
                             Text="{Binding Accuracy, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Функция:" Width="130"/>
                    <TextBlock Text="f(x) = x³ - x - 2" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Вычислить корень" 
                    Command="{Binding CalculateCommand}"
                    Style="{StaticResource CalculateButton}"/>
            <Button Content="Загрузить историю" 
                    Command="{Binding LoadHistoryCommand}"
                    Style="{StaticResource CalculateButton}"/>
            <Button Content="Очистить историю" 
                    Command="{Binding ClearHistoryCommand}"
                    Style="{StaticResource CalculateButton}"
                    Background="#FFf44336"/>
        </StackPanel>

        <!-- Результаты -->
        <GroupBox Grid.Row="2" Header="Результат" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10">
                    <TextBlock FontSize="14" Margin="5">
                        <Run Text="Корень: " FontWeight="Bold"/>
                        <Run Text="{Binding LastResult.Root, StringFormat=F6}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="5">
                        <Run Text="f(root): "/>
                        <Run Text="{Binding LastResult.FunctionValue, StringFormat=F8}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="5">
                        <Run Text="Итераций: "/>
                        <Run Text="{Binding LastResult.Iterations}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="5">
                        <Run Text="Точность: "/>
                        <Run Text="{Binding LastResult.Accuracy, StringFormat=E2}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="5">
                        <Run Text="Статус: "/>
                        <Run Text="{Binding StatusMessage}"/>
                    </TextBlock>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding History}" 
                          AutoGenerateColumns="False" 
                          Margin="10"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CalculationDate}" Width="150"/>
                        <DataGridTextColumn Header="Интервал" 
                                            Binding="{Binding Path=., StringFormat='[{0:F2}; {1:F2}]'}" 
                                            Width="100"/>
                        <DataGridTextColumn Header="Корень" Binding="{Binding Root, StringFormat=F6}" Width="100"/>
                        <DataGridTextColumn Header="Итераций" Binding="{Binding Iterations}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
